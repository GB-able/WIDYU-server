{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/application-prod.yml)",
      "Read(./**/application-secret.yml)",
      "Read(./src/main/resources/firebase/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.p8)",
      "Bash(cat ./.env:*)",
      "Bash(cat .env:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/harness/pre-edit-branch-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/harness/on-file-edit.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/harness/audit-log.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/harness/audit-log.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/harness/on-stop.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/harness/audit-log.sh"
          }
        ]
      }
    ]
  }
}
